Cell[CellGroupData[{

Cell["list of dicts", "Subsubsection",
 CellChangeTimes->{
  3.970233155307616*^9, {3.9702332071778316`*^9, 
   3.970233207929923*^9}},ExpressionUUID->"e7a3e4f6-fedb-43f0-947e-\
a2a5ea644e60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"listOfDicts", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"list", " ", "of", " ", "dicts"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of dicts\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<list of dicts\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|\
>}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[{\\\"a\\\": 1, \\\"b\\\": 2},{\\\"a\\\": 3, \\\"b\\\": \
4}]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<List of dicts is Python's equivalent of a table/DataFrame.\
\nEach dict is a row; keys are column names.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of dicts\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract column from ld\>\""}], ",", 
       
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d={<|\\\"a\\\"->1,\\\"b\\\"->2,\\\"c\\\"->5|>,<|\\\"a\\\"->\
3,\\\"b\\\"->4|>};\\nd[[All,\\\"b\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = [{\\\"a\\\": 1, \\\"b\\\": 2, \\\"c\\\": \
5},{\\\"a\\\": 3, \\\"b\\\": 4}];\\n[elem[\\\"b\\\"] for elem in d]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<List comprehension [d['key'] for d in ld].\nAlternative: \
operator.itemgetter('key').\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of dicts\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<select entry in ld\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<people={<|\\\"name\\\"->\\\"John\\\",\\\"age\\\"->25|>,<|\\\
\"name\\\"->\\\"Jane\\\",\\\"age\\\"->30|>};\\nSelect[people,(#[\\\"name\\\"]=\
=\\\"John\\\")&]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<people=[{'name': 'John', 'age': 25},{'name': 'Jane', \
'age': 30}]\\n[elem for elem in people if elem['name'] == 'John']\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<next((d for d in ld if d['key']==val), None)\nfor first \
match. List comp for all matches.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of dicts\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort ld by entry\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<people={<|\\\"name\\\"->\\\"John\\\",\\\"age\\\"->45|>,<|\\\
\"name\\\"->\\\"Jane\\\",\\\"age\\\"->30|>};\\nSortBy[people,#\\\"age\\\"&]\>\
\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<people=[{'name': 'John', 'age': 45},{'name': 'Jane', \
'age': 30}]\\nsorted(people,key=lambda item : item['age'])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sorted(ld, key=lambda d: d['key']).\nUse \
operator.itemgetter('key') for cleaner syntax.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "listOfDicts", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9702336199825897`*^9, 3.970233630636127*^9}, {
   3.970234101881775*^9, 3.970234103750937*^9}, {3.9702346492255087`*^9, 
   3.970234659766939*^9}, {3.970234691347287*^9, 3.9702346979118443`*^9}, {
   3.970234742045045*^9, 3.9702347828693523`*^9}, {3.970313314673171*^9, 
   3.9703133921773043`*^9}, {3.970313575027087*^9, 3.970313588008387*^9}, {
   3.971089837757433*^9, 3.971089856133337*^9}, {3.971374465874954*^9, 
   3.971374469369857*^9}, 3.9850893318547564`*^9},
 CellLabel->
  "In[472]:=",ExpressionUUID->"913c0e51-f148-429c-a399-b0f3eb47d270"]
}, Closed]],

Cell[CellGroupData[{

Cell["deque", "Subsubsection",
 CellChangeTimes->{{3.9703192936590643`*^9, 3.970319294299321*^9}, 
   3.970321225691868*^9, {3.9703240204256573`*^9, 
   3.970324021083128*^9}},ExpressionUUID->"77549c9d-ac1f-410b-b621-\
45fb92fb68ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"deque", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "deque", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<initialize empty\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<q = CreateDataStructure[\\\"Deque\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import deque;q=deque()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) time to allocate empty queue\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<get length\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<q=CreateDataStructure[\\\"Deque\\\",{2,3,4}];q[\\\"Length\\\
\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import \
deque;q=deque([2,3,4]);len(q)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<O(1) time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<peek front\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<q=CreateDataStructure[\\\"Deque\\\",{3,2}];q[\\\"PeekFront\
\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import deque;q=deque([3,2]);q[0]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<O(1) time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<enqueue (push to right)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<q=CreateDataStructure[\\\"Deque\\\"];q[\\\"PushBack\\\",2];\
\\nq[\\\"PushBack\\\",3];q[\\\"PushBack\\\",4];q[\\\"PeekFront\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import \
deque;q=deque();q.append(2);\\nq.append(3);q.append(4);q[0]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<O(1) amortised time\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<dequeue (pop from front)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<q=CreateDataStructure[\\\"Deque\\\",{2,3,4}];q[\\\"\
PopFront\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import deque;q=deque([2,3,4]);q.popleft()\
\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<O(1) time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<deque\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<clear queue\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<ds[\\\"DropAll\\\"]\>\""}], 
       ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<q.clear()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) time, where n = number of elements\>\""}]}], "|>"}]}],
     "\[IndentingNewLine]", "}"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "deque", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970320516764175*^9, 3.970320516766802*^9}, {
   3.970320609709614*^9, 3.970320633430072*^9}, {3.970320716522745*^9, 
   3.970320726972218*^9}, {3.970320932529614*^9, 3.9703209356797323`*^9}, {
   3.970321221018515*^9, 3.970321228209155*^9}, {3.970321299238872*^9, 
   3.970321311668015*^9}, {3.970321407646904*^9, 3.970321414675758*^9}, {
   3.970321522739509*^9, 3.970321529655575*^9}, 3.9703217698996572`*^9, {
   3.970321908312066*^9, 3.9703219153851557`*^9}, {3.970321986835125*^9, 
   3.9703220130694523`*^9}, {3.9703224603148537`*^9, 
   3.9703224856983967`*^9}, {3.970322595148884*^9, 3.970322595772397*^9}, {
   3.9703232129850492`*^9, 3.970323272560195*^9}, {3.970323468272078*^9, 
   3.9703234686328773`*^9}, {3.970323534618465*^9, 3.9703235446794147`*^9}, {
   3.970323591780397*^9, 3.970323613102715*^9}, {3.970323864541955*^9, 
   3.970323865262187*^9}, {3.971263598236051*^9, 3.97126360284936*^9}},
 CellLabel->
  "In[474]:=",ExpressionUUID->"b88296fb-bffe-4e7e-b29c-4390f74d4bcb"]
}, Closed]],

Cell[CellGroupData[{

Cell["set", "Subsubsection",
 CellChangeTimes->{{3.9703192936590643`*^9, 
  3.970319310611827*^9}},ExpressionUUID->"e87ae080-3838-4403-91c3-\
3db0c4c70bb6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"set", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "set", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<initialization empty\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<(*No hash-set;use a list and Unique*)\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<s = set()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time to create empty set\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<initialization from iterable\>\""}],
        ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s={1,2,2,2,3,3};s=DeleteDuplicates[s];s\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=set([1,2,2,2,3,3]);s\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) where n is number of elements\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<set comprehension\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Union[Table[elem,{elem,{2,1,1,2,3}}]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<{elem for elem in [2,1,1,2,3]}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) where n is number of elements\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<add element\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s={1,2,2,2,3,3};s=DeleteDuplicates[s];AppendTo[s,5]\>\""}],
        ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=set([1,2,2,2,3,3]);s.add(5);s\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time complexity (hash table)\>\""}]}], "|>"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<add multiple elements\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s={1,2,2,2,3,3};s=DeleteDuplicates[s];Union[s,{5,6}]\>\""}]\
, ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=set([1,2,2,2,3,3]);s.update([5,6]);s\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(k) where k = number of elements added\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", 
        "->", "\"\<remove element (error if absent)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s={1,2,2,2,3,3};s=DeleteDuplicates[s];DeleteElements[s,{2}]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=set([1,2,2,2,3,3]);s.remove(2);s\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time complexity\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<remove element safely\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s={1,2,2,2,3,3};s=DeleteDuplicates[s];DeleteElements[s,{4}]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=set([1,2,2,2,3,3]);s.discard(4);s\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time complexity\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
        RowBox[{"\"\<name\>\"", "->", "\"\<pop arbitrary element\>\""}], ",", 
        
        RowBox[{
         RowBox[{"\"\<wolfram_code\>\"", "->", 
          RowBox[{"\"\<\>", 
           RowBox[{"(*", " ", 
            RowBox[{"Mathematica", ":", " ", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", "=", 
                 RowBox[{"First", "[", "l", "]"}]}], "}"}], ",", " ", 
               RowBox[{"l", " ", "=", " ", 
                RowBox[{"DeleteCases", "[", 
                 RowBox[{"l", ",", " ", "x"}], "]"}]}]}], "]"}]}], " ", 
            "*)"}], "\"\<,\>\"", "python_code", "\"\<->\>\"", 
           RowBox[{"s", ".", "pop"}], 
           RowBox[{"(", ")"}], "\"\<,\>\"", "evaluate", "\"\<->True,\>\"", 
           "note", "\"\<->\>\"", "O", 
           RowBox[{"(", "1", ")"}], " ", "average", " ", "time", " ", 
           "complexity", "\"\<|>,\[IndentingNewLine]<|\>\"", 
           "cat", "\"\<->\>\"", "set", "\"\<,\>\"", "name", "\"\<->\>\"", 
           "clear", " ", "all", " ", "elements", "\"\<,\>\"", 
           "wolfram_code", "\"\<->\>\"", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Mathematica", ":", " ", "l"}], " ", "=", " ", 
             RowBox[{"{", "}"}]}], " ", "*)"}], "\"\<,\>\"", 
           "python_code", "\"\<->\>\"", 
           RowBox[{"s", ".", "clear"}], 
           RowBox[{"(", ")"}], "\"\<,\>\"", "evaluate", "\"\<->True,\>\"", 
           "note", "\"\<->\>\"", "O", 
           RowBox[{"(", "n", ")"}], " ", "where", " ", "n"}]}], " ", "=", " ", 
         RowBox[{
         "number", " ", "of", " ", "elements", " ", "in", " ", 
          "set", "\"\<|>,\>"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<union\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Union[{1,2,3},{3,4,5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<{1,2,3} | {3,4,5}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(len(a) + len(b)) average time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<intersection\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Intersection[{1,2,3},{3,4,5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<{1,2,3} & {3,4,5}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(min(len(a), len(b))) average time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<difference\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Complement[{1,2,3},{3,4,5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<{1,2,3} - {3,4,5}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<O(len(a)) average time\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<symmetric difference\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<SymmetricDifference[{1,2,3},{3,4,5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<{1,2,3} ^ {3,4,5}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(len(a) + len(b)) average time\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<set\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<membership test\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<MemberQ[{1,2,3}, 3]\>\""}], 
       ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<3 in {1,2,3}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time complexity (hash table lookup)\>\""}]}], 
      "|>"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "set", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970328442136024*^9, 3.9703284703919086`*^9}, {
   3.970329320097619*^9, 3.970329377898427*^9}, {3.970406031091803*^9, 
   3.970406049692361*^9}, {3.9704062192551003`*^9, 3.97040621970196*^9}, {
   3.9704065706090508`*^9, 3.970406570976506*^9}, {3.9704066151421757`*^9, 
   3.9704066219284573`*^9}, {3.970406667011777*^9, 3.970406673621409*^9}, {
   3.970407834167221*^9, 3.97040783461399*^9}, {3.970407877640101*^9, 
   3.970407878054678*^9}, {3.970407989360757*^9, 3.97040800476226*^9}, {
   3.970411386432343*^9, 3.9704114621759033`*^9}, 3.970411511592393*^9, 
   3.970411995870723*^9, {3.971089895524939*^9, 3.971089899470673*^9}, {
   3.971093456518034*^9, 3.9710934801431828`*^9}, {3.972480225194578*^9, 
   3.972480248459391*^9}, {3.9724804606524363`*^9, 3.9724804612684727`*^9}},
