Cell[CellGroupData[{

Cell["torch", "Subsubsection",
 CellChangeTimes->{{3.970240780556356*^9, 3.970240781596426*^9}, {
  3.970831328754921*^9, 3.970831329562405*^9}, {3.97190542463056*^9, 
  3.9719054263397293`*^9}},ExpressionUUID->"6ab5795b-3d4b-4aed-9cec-\
f3a1cde70c3c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"torch", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<torch\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<torch array\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{{1,2},{3,4}}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import torch\\ntorch.tensor([[1,2],[3,4]]).tolist()\>\""}],
        ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<torch.tensor(data) creates new tensor (copies data).\n\
torch.from_numpy(arr) shares memory with numpy array.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<torch\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<torch reshape\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m={{1,2},{3,4}};\\n{ArrayReshape[m,{1,4}],ArrayReshape[m,{\
4,1}],\\nArrayReshape[m,{1,4}],ArrayReshape[m,{4,1}]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import \
torch\\nm=torch.tensor([[1,2],[3,4]])\\n[m.reshape(1,4).tolist(),m.reshape(4,\
1).tolist(),\\n m.view(1,4).tolist(),m.view(4,1).tolist()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<view() requires the tensor to be contiguous (close in mem)\
\\nand always returns a view, while reshape() works\\neven on non-contiguous \
tensors but may make a copy. \>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<torch\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<torch nn\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<hiddenDim=5;outputDim=1;\\nnet=NetInitialize[NetChain[{\
LinearLayer[hiddenDim],\\n \
Ramp,LinearLayer[outputDim]},\\\"Input\\\"->2]];\\noutput=net[{1.0,2.0}]\>\""}\
], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import torch.nn as \
nn\\nhidden_dim=5;output_dim=1;\\nnet=nn.Sequential(nn.Linear(2, hidden_dim),\
\\n nn.ReLU(),nn.Linear(hidden_dim, \
output_dim))\\noutput=net(torch.tensor([1.0, 2.0]))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<torch.nn provides layers, loss functions, and model \
building blocks.\nSubclass nn.Module for custom models.\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<torch\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<gather\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<piLogits={{{1.2,0.5},{0.1,-1.0}}};\\nlabels={{1,2}};\\\
nlogProbs=Log[SoftmaxLayer[-1]/@piLogits];\\nTable[logProbs[[b,i,labels[[b,i]]\
]],\\n{b,1,Length[labels]},{i,1,Length[labels[[b]]]}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import torch\\nimport torch.nn.functional as \
F\\npi_logits=torch.tensor([[[1.2,0.5],[0.1,-1.0]]])\\nlabels=torch.tensor([[\
0,1]])\\nlog_probs=F.log_softmax(pi_logits, \
dim=-1)\\npi_log_probs=torch.gather(log_probs,dim=-1,\\nindex=labels.\
unsqueeze(-1)).squeeze(-1)\\npi_log_probs.tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<torch.gather(input, dim, index) selects elements along \
dim.\nUseful for batch-wise element selection in ML.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "torch", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.971905440747015*^9, 3.9719054474424973`*^9}, {
   3.9719093459489193`*^9, 3.9719093555264463`*^9}, {3.9719715300791273`*^9, 
