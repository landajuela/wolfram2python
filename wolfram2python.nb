Cell[BoxData[{
 RowBox[{
  RowBox[{"WolframPython", "=", 
   RowBox[{"Join", "@@", "all"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"orderOfCategories", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"\"\<general\>\"", ",", "\[IndentingNewLine]", "\"\<list\>\"", ",",
      "\[IndentingNewLine]", "\"\<list of lists\>\"", ",", 
     "\[IndentingNewLine]", "\"\<dict\>\"", ",", 
     "\[IndentingNewLine]", "\"\<list of dicts\>\"", ",", 
