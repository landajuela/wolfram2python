  3.9718006057909946`*^9}},ExpressionUUID->"479ecbba-9aca-427a-bd02-\
7b641ac638ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RunWolfram", "[", "code_", "]"}], ":=", 
   RowBox[{"ToExpression", "[", "code", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "PYTHONIMPORT", 
   "=", "\"\<\nimport pandas as pd\nimport numpy as np\nimport re\nimport \
torch\n\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PYTHONEVALUATOR", "=", 
   RowBox[{"<|", 
    RowBox[{"\"\<Dependencies\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<pandas\>\"", ",", "\"\<numpy\>\"", ",", "\"\<torch\>\""}], 
      "}"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RunPython", "[", "code_", "]"}], ":=", 
   RowBox[{"ExternalEvaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Python\>\"", ",", 
       RowBox[{"\"\<Evaluator\>\"", "->", "PYTHONEVALUATOR"}]}], "}"}], ",", 
     RowBox[{"PYTHONIMPORT", "<>", "code"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000477611266178*^9, 4.000477627639945*^9}, {
  4.000477737487949*^9, 4.00047773895479*^9}, {4.00047787516259*^9, 
  4.000477886865107*^9}},
 CellLabel->
  "In[290]:=",ExpressionUUID->"e0049a4c-10e4-41f3-8519-d2b5cfe1c1aa"],

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Python\>\"", ",", 
     RowBox[{"\"\<Evaluator\>\"", "->", "PYTHONEVALUATOR"}]}], "}"}], 
   ",", "\"\<\nimport pandas\nimport numpy\nimport torch\n{\n    'python': \
__import__('sys').executable,\n    'pandas': pandas.__version__,\n    \
'numpy': numpy.__version__,\n\t'torch': torch.__version__\n}\n \>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.000477675525383*^9, 4.000477677740258*^9}, {
  4.000477816450857*^9, 4.0004778322471*^9}, {4.000477935552545*^9, 
  4.00047793577938*^9}},
 CellLabel->
  "In[294]:=",ExpressionUUID->"ecd933f6-8eb8-4867-9d99-e069fdef310b"]
}, Closed]],

