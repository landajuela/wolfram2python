Cell[CellGroupData[{

Cell["list of lists", "Subsubsection",
 CellChangeTimes->{
  3.970233155307616*^9},ExpressionUUID->"5b1b5170-b170-4212-af2f-\
ffb0a590cbf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"listOfLists", "=", 
   RowBox[{"{", 
    RowBox[{"(*", 
     RowBox[{"list", " ", "of", " ", "lists"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{{1,2},{3,4}}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<[[1,2],[3,4]]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Nested list. Access element: l[row][col].\\nNo built-in \
matrix operations; use numpy for that.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<comprehension (ll)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Table[r+c,{r,0,2},{c,0,r-1}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[[r+c for c in range(r)] for r in range(3)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Nested list comprehension reads outer-to-inner \
left-to-right.\\nEquivalent to nested for loops.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract column (ll)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={{1,2},{3,4,5}};l[[All,2]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[[1,2],[3,4,5]]; [row[1] for row in l]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Unless you use Numpy, you must iterate through all \
sublists.\\nLists don\[CloseCurlyQuote]t have the column concept built \
in.O(n) per column.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract columns (ll)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<cols={1,2,1};\\nl={{1,2,3},{3,4},{5,6,7}};\\nTable[l[[i,\
cols[[i]]]],{i,1,Length[l]}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<cols = [1, 2, 1]\\nl =[[1, 2, 3],[3, 4],[5, 6, \
7]]\\n[row[cols[i] - 1] for i, row in enumerate(l)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Index mapping across ragged lists with enumerate.\>\""}]}],
       "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sorted (ll)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l = {{\\\"b\\\", 3},{\\\"a\\\", 5},{\\\"a\\\", 4},{\\\"b\\\
\", 2}};\\nSortBy[l, {First, Last}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[[\\\"b\\\",3],[\\\"a\\\",5],[\\\"a\\\",4],[\\\"b\\\",2]]\
;\\nsorted(l,key=lambda item : [item[0],item[1]])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sorted() with key=lambda for multi-key sorting.\\nPython \
sort is stable: equal elements keep original order.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<flatten nested\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Flatten[{{1,2},{3,4}}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[[1, 2], [3, 4]]; [x for sub in l for x in sub]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<iterating over each sub-list and then over each element in \
the sub-list\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list of lists\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<partition/chunk\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Partition[{1,2,3,4,5,6,7}, UpTo[2]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l = [1,2,3,4,5,6,7]; [l[i:i+2] for i in range(0, len(l), \
2)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Chunking with stride. O(n) time, O(n) space.\\n See also: \
itertools.batched() in Python 3.12+.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "listOfLists", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233173808771*^9, 3.970233182102332*^9}, {
   3.970324241873082*^9, 3.9703242423379087`*^9}, {3.97109030193506*^9, 
   3.971090317397911*^9}, {3.971879670470303*^9, 3.9718797214265423`*^9}, {
   3.971882556651886*^9, 3.971882563874098*^9}, {3.972990911834836*^9, 
   3.972990939455711*^9}, {3.9849528165861197`*^9, 3.984952847647212*^9}, 
   3.9850255187886477`*^9, 3.985025559485504*^9, {3.985025593382854*^9, 
   3.985025595970377*^9}, {3.985025646243951*^9, 3.985025648811988*^9}},
 CellLabel->
  "In[468]:=",ExpressionUUID->"83051baf-edd9-4d3c-a974-98c91e31fbcc"]
}, Closed]],

Cell[CellGroupData[{

Cell["dict", "Subsubsection",
 CellChangeTimes->{
  3.970233155307616*^9, {3.970233200248769*^9, 
   3.9702332007297363`*^9}},ExpressionUUID->"30256e50-ec16-4833-b1e7-\
266aab646039"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dict", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "dict", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<<|\\\"a\\\"->2,\\\"b\\\"->2,\\\"c\\\"->9,\\\"d\\\"->6,\\\"\
e\\\"->7|>\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<{\\\"a\\\":2,\\\"b\\\":2,\\\"c\\\":9,\\\"d\\\":6,\\\"e\\\":\
7}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python dict preserves insertion order (guaranteed since \
3.7).\nKeys must be hashable (immutable). O(1) avg lookup.\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<init from list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Association[{\\\"b\\\"\[Rule]2,\\\"a\\\"\[Rule]1,\\\"c\\\"\
\[Rule]3}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<dict([['b',2],['a',1],['c',3]])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<dict(pairs) or dict(zip(keys,vals)).\nAlso: {k:v for k,v \
in pairs} dict comprehension.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<access element in dict\>\""}], ",", 
       
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<<|\\\"a\\\"->2,\\\"b\\\"->2,\\\"c\\\"->9,\\\"d\\\"->6,\\\"\
e\\\"->7|>[\\\"a\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<{\\\"a\\\":2,\\\"b\\\":2,\\\"c\\\":9,\\\"d\\\":6,\\\"e\\\":\
7}[\\\"a\\\"]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time (hash table lookup).\nRaises KeyError if \
missing; use .get(k, default) for safe access.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<add or update key\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d = <|\\\"a\\\"->1|>; d[\\\"b\\\"] = 2; d\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {\\\"a\\\": 1}; d[\\\"b\\\"] = 2; d\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) average time (hash table insertion/update).\nAlso: \
d.setdefault(key, default) inserts only if absent.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<remove key\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<KeyDrop[<|\\\"a\\\"->1,\\\"b\\\"->2|>, \\\"a\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {\\\"a\\\": 1, \\\"b\\\": 2};d.pop(\\\"a\\\"); \
d\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) (average) time complexity in Python (hash table \
insertion)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<value apply\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d=<|\\\"a\\\"->{1,2},\\\"b\\\"->{2,3}|>;\\nMapApply[#2&,d]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d={\\\"a\\\":[1,2],\\\"b\\\":[2,3]}\\n{k: v[1] for k,v in \
d.items()}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Apply function to dict values using comprehension.\n{k: \
f(v) for k,v in d.items()}.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<get keys\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Keys[<|\\\"a\\\"->1,\\\"b\\\"->2|>]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {\\\"a\\\": 1, \\\"b\\\": 2}; d.keys()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) (must iterate through all entries)\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<get values\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Values[<|\\\"a\\\"->1,\\\"b\\\"->2|>]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {\\\"a\\\": 1, \\\"b\\\": 2}; d.values()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) to iterate. Returns a view object that reflects live \
changes.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<get key-values\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d=<|\\\"a\\\"->1,\\\"b\\\"->2|>; \
MapApply[{#1,#2}&,Normal[d]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {\\\"a\\\": 1, \\\"b\\\": 2}; d.items()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<d.items() returns view of (key, value) pairs.\nEssential \
for iterating dicts; commonly used in for k,v in d.items().\>\""}]}], "|>"}], 
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort by key\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d=<|\\\"b\\\"->2,\\\"a\\\"->1,\\\"c\\\"->3|>;\\nKeySort[d]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d = {'b': 2,'a': 1,'c':3}\\ndict(sorted(d.items()))\>\""}],
        ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Sorting a dictionary in Python involves creating a new, \
ordered\\nrepresentation of its key-value pairs, as dictionaries \
themselves\\nare inherently unordered\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort by value\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<d=<|\\\"b\\\"->2,\\\"a\\\"->1,\\\"c\\\"->3|>;\\\
nAssociation@SortBy[Normal[d],#[[-1]]&]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<d={'b': 2, 'a': 1, 'c': 3};\\ndict(sorted(d.items(), \
key=lambda kv: kv[1]))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Sorting a dictionary in Python involves creating a new, \
ordered\\nrepresentation of its key-value pairs, as dictionaries \
themselves\\nare inherently unordered\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<merge dict out-of-place\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<a=<|\\\"b\\\"->2,\\\"a\\\"->1,\\\"c\\\"->3|>;b=<|\\\"d\\\"-\
>2,\\\"e\\\"->1,\\\"c\\\"->4|>;\\nJoin[a,b]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<a={\\\"b\\\":2,\\\"a\\\":1,\\\"c\\\":3};b={\\\"d\\\":2,\\\"\
e\\\":1,\\\"c\\\": 4};\\na | b\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<{**a, **b} creates new merged dict (Python 3.5+).\na | b \
also works (Python 3.9+). Last key wins.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<merge dict in-place\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<a=<|\\\"b\\\"->2,\\\"a\\\"->1,\\\"c\\\"->3|>;b=<|\\\"d\\\"-\
>2,\\\"e\\\"->1,\\\"c\\\"->4|>;\\nAssociateTo[a,b];a\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<a={\\\"b\\\":2,\\\"a\\\":1,\\\"c\\\":3};b={\\\"d\\\":2,\\\"\
e\\\":1,\\\"c\\\": 4};\\na.update(b);a\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<a.update(b) merges b into a, mutating a.\na |= b also \
works (Python 3.9+). Last key wins.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dict\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<unpack a dictionary\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Association[\\\"A\\\"->1,Table[ToString[i]->i,{i,2,3}],\\\"\
J\\\"->4]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<{\\\"A\\\": 1, **{str(i): i for i in range(2, 3+1)}, \\\"J\
\\\": 4}\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python `**` unpacks/merges key\[Dash]value pairs\\nfrom \
another dict inline inside a literal.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "dict", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233373342244*^9, 3.970233405063806*^9}, {
   3.97024047280215*^9, 3.970240514748324*^9}, {3.970264622580502*^9, 
   3.970264742969049*^9}, {3.9702648685628843`*^9, 3.970264896373413*^9}, {
