Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ManualPythonTutorLink", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ManualPythonTutorLink", "[", "\[IndentingNewLine]", 
   RowBox[{"code_String", ",", "\[IndentingNewLine]", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Cumulative\>\"", "->", "False"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<CurInstr\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<HeapPrimitives\>\"", "->", "\"\<nevernest\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Mode\>\"", "->", "\"\<display\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Origin\>\"", "->", "\"\<opt-frontend.js\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<PyVersion\>\"", "->", "\"\<311\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<RawInput\>\"", "->", "\"\<[]\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<TextReferences\>\"", "->", "False"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
      "baseURL", "=", "\"\<https://pythontutor.com/render.html#\>\""}], ",", 
      "params", ",", "encode", ",", "kvPairs", ",", "queryString"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"helper", " ", "to", " ", "percent"}], "-", 
      RowBox[{"encode", " ", "in", " ", "ASCII"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"encode", "[", "s_", "]"}], ":=", 
      RowBox[{"URLEncode", "[", 
       RowBox[{"s", ",", 
        RowBox[{"CharacterEncoding", "->", "\"\<ASCII\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "collect", " ", "all", " ", "our", " ", "parameters", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{"key", ",", "value"}], "}"}], " ", "pairs"}], "*)"}], 
     RowBox[{"params", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<code\>\"", "->", "code"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<cumulative\>\"", "->", 
         RowBox[{"ToLowerCase", "@", 
          RowBox[{"ToString", "@", 
           RowBox[{"OptionValue", "[", "\"\<Cumulative\>\"", "]"}]}]}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"\"\<curInstr\>\"", "->", 
         RowBox[{"ToString", "@", 
          RowBox[{"OptionValue", "[", "\"\<CurInstr\>\"", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<heapPrimitives\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<HeapPrimitives\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<mode\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<Mode\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<origin\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<Origin\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<py\>\"", "->", 
         RowBox[{"ToString", "@", 
          RowBox[{"OptionValue", "[", "\"\<PyVersion\>\"", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<rawInputLstJSON\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<RawInput\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<textReferences\>\"", "->", 
         RowBox[{"ToLowerCase", "@", 
          RowBox[{"ToString", "@", 
           RowBox[{
           "OptionValue", "[", "\"\<TextReferences\>\"", "]"}]}]}]}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"build", " ", "\"\<key=encodedValue\>\"", " ", "strings"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"kvPairs", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "kv", "}"}], ",", 
          RowBox[{
           RowBox[{"kv", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<=\>\"", "<>", 
           RowBox[{"encode", "[", 
            RowBox[{"kv", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], ",", 
        "params"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"join", " ", "them", " ", "with"}], "&"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"queryString", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{"kvPairs", ",", "\"\<&\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"assemble", " ", "final", " ", "URL"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Hyperlink", "[", 
      RowBox[{"baseURL", "<>", "queryString"}], "]"}]}]}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.957630437116272*^9, 3.9576304371193037`*^9}, {
  3.957630512024132*^9, 3.957630569474414*^9}, {3.957630806459031*^9, 
