   3.9702636560177402`*^9}, {3.9703128360095997`*^9, 3.970313057944996*^9}, {
   3.970318489009345*^9, 3.9703185616436977`*^9}, {3.970319172595489*^9, 
   3.970319185794468*^9}, {3.970324221819254*^9, 3.970324225802264*^9}, {
   3.97041236663424*^9, 3.970412397592638*^9}, {3.9704877789533443`*^9, 
   3.970487797070674*^9}, {3.970487893293641*^9, 3.9704879013395*^9}, {
   3.970514652193269*^9, 3.970514664937729*^9}, {3.9705147264083557`*^9, 
   3.970514753760853*^9}, {3.970514861538678*^9, 3.970514865194153*^9}, {
   3.970514915235785*^9, 3.970514923179281*^9}, 3.97051496811972*^9, {
   3.970515019238017*^9, 3.970515039163509*^9}, {3.970583437438555*^9, 
   3.970583471302959*^9}, {3.970659412536357*^9, 3.970659412656267*^9}, {
   3.97065944693962*^9, 3.970659448000929*^9}, {3.970921442469493*^9, 
   3.9709214989260902`*^9}, {3.970921574304914*^9, 3.970921575171845*^9}, {
   3.9710238099886017`*^9, 3.971023828349112*^9}, 3.971131617827313*^9, {
   3.971131765114275*^9, 3.971131796628851*^9}, {3.9711319062068987`*^9, 
   3.97113197529486*^9}, 3.971142603260448*^9, {3.971180492636381*^9, 
   3.9711805004231033`*^9}, {3.971180572243177*^9, 3.9711805911452513`*^9}, {
   3.9711806350063562`*^9, 3.971180635633992*^9}, {3.971784332429234*^9, 
   3.971784374624611*^9}, {3.971873771839555*^9, 3.9718737879217567`*^9}, {
   3.9719089438054943`*^9, 3.971908946055925*^9}, {3.971909096916513*^9, 
   3.971909132635212*^9}, {3.971909181318315*^9, 3.971909182828937*^9}, {
   3.9720645108123283`*^9, 3.972064513330987*^9}, {3.984943004652083*^9, 
