Cell[BoxData[{
 RowBox[{
  RowBox[{"list", "=", 
   RowBox[{"{", 
    RowBox[{"(*", "list", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{2,2,9,6,7}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<[2,2,9,6,7]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python list is a dynamic array.\\nO(1) index access, O(1) \
amortized append, O(n) insert/delete.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<length of list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Length[{2, 2, 9, 6, 7}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<len([2,2,9,6,7])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) - Python caches the length internally.\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<append to list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,2,9,6,7}; AppendTo[l,2];l\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,2,9,6,7]; l.append(2); l\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) time complexity in Python\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<insert to list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,2,9,6,7};l=Insert[l,3,1+1];l\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,2,9,6,7]; l.insert(1,3); l\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(n) time complexity in Python\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<pop (last) from list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,2,9,6,7}; {Last[l],Drop[l,-1]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,2,9,6,7]; [l.pop(),l]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) time complexity in Python\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<pop (index) from list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,3,9,6,7}; {l[[2]],Delete[l, 2]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,3,9,6,7]; [l.pop(1),l]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) time complexity in Python\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extend list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,2,9,6,7};l=Join[l,{5,6}];l\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,2,9,6,7]; l.extend([5, 6]);l\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(k) (k elements inserted) time complexity in \
Python\\n(in-place modification of the list)\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<slice list\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={2,2,9,6,7};{l[[;;]],l[[2;;]],l[[;;2]],\\nl[[2;;4]],l[[1;\
;-1-1;;2]],l[[1;;-1;;2]]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[2,2,9,6,7];[l[:],l[1:],l[:2],\\nl[1:3+1],l[0:-1:2],l[::\
2]]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python slices use seq[start:stop:step], inclusive of start \
and exclusive of stop.\\nNegative indices count from the end. l[::2] \
\[RightArrow] [2,9,7] matches Mathematica\[CloseCurlyQuote]s\\nl[[1;;-1;;2]], \
which is 1-based and inclusive.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<join lists\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{1,2}~Join~{3,4}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<[1,2]+[3,4]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<In Python, using + to concatenate two lists\\ncreates a \
new list and thus has O(n + m) time complexity.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<zip 2 lists\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Transpose[{{\\\"a\\\",\\\"b\\\",\\\"c\\\",\\\"d\\\",\\\"e\\\
\"},{2,2,9,6,7}}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<zip([\\\"a\\\",\\\"b\\\",\\\"c\\\",\\\"d\\\",\\\"e\\\"],[2,\
2,9,6,7])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<zip() returns iterator of tuples, stops at shortest input.\
\\nUse itertools.zip_longest() to pad shorter ones.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<get element position\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Position[{a,b,a,b},b]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[[i + 1] for i,v in enumerate(['a','b','a','b']) if v == \
'b']\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<\\\"+1\\\" because 1-indexed (Mathematica) vs 0-indexed \
(Python)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<random sample\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<RandomSample[{1,2,3,4}, 2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import random;random.sample([1,2,3,4], 2)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<random.sample(pop, k) returns k unique elements (no \
replacement).\\nrandom.choices(pop, k=k) allows replacement.\>\""}]}], "|>"}],
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<reverse list (out-of-place)\>\""}], 
       ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Reverse[{1,2,3}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<list(reversed([1,2,3]))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<reversed() gives an (out-of-place) iterator to the \
reversed list\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", 
        "->", "\"\<reverse list (slicing, out-of-place)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{1,2,3}[[-1;;1;;-1]]\>\""}],
        ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<[1,2,3][::-1]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<new (out-of-place) list\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<reverse list (in-place)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Reverse[{1,2,3}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[1,2,3];l.reverse();l\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<list.reverse() is in-place in Python (no in-place \
equivalent in Mathematica)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<unique in list (non-stable)\>\""}], 
       ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<DeleteDuplicates[{9, 2, 2, 9, 6}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<list(set([9, 2, 2, 9, 6]))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<DeleteDuplicates preserves order (order not guaranteed in \
set())\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<unique in list (stable)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<DeleteDuplicates[{2, 2, 9, 6}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<seen = set(); [x for x in [2,2,9,6] if not (x in seen or \
seen.add(x))]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<seen.add(x) adds x to the set and returns None ('or' \
evaluates the fist)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort list (basic)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={5,3,2,6,1}; Sort[l]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[5,3,2,6,1]; sorted(l)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sorted() is stable and out-of-place\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", 
        "->", "\"\<sort list (stable, out-of-place)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<words = {\\\"apple\\\", \\\"bat\\\", \\\"banana\\\", \
\\\"car\\\"};\\nReverseSortBy[words,{StringLength,(-Position[words,#][[1]]&)}]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<words = [\\\"apple\\\", \\\"bat\\\", \\\"banana\\\", \
\\\"car\\\"]\\nsorted(words, key=len, reverse=True)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sorted() is stable and out-of-place\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<list\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort list (stable,in-place)\>\""}], 
       ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<words = {\\\"apple\\\", \\\"bat\\\", \\\"banana\\\", \
\\\"car\\\"};\\nReverseSortBy[words,{StringLength,(-Position[words,#][[1]]&)}]\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<words = [\\\"apple\\\", \\\"bat\\\", \\\"banana\\\", \
\\\"car\\\"]\\nwords.sort(key=len, reverse=True);words\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<list.sort() is stable and in-place (no in-place equivalent \
in Mathematica)\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "list", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
