Cell[CellGroupData[{

Cell["math", "Subsubsection",
 CellChangeTimes->{
  3.9702333586599083`*^9},ExpressionUUID->"ba59c52e-bed4-40c6-9199-\
c2b071abe7ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"math", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "math", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<factorial\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Factorial[7]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import math; math.factorial(7)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<math.factorial(n). O(n) multiplications.\nReturns int \
(arbitrary precision in Python).\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<square root\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Sqrt[9]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import math; math.sqrt(9)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<math.sqrt(x) or x**0.5. Returns float.\nmath.isqrt(x) for \
exact integer sqrt (Python 3.8+).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<total\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Total[{2, 2, 9, 6, 7}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<sum([2, 2, 9, 6, 7])\>\""}], 
       ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sum(iterable, start=0). O(n).\nmath.fsum() for better \
floating point precision.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<mod\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Mod[30,12]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<30 % 12\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<% operator. Python mod result has same sign as divisor.\n\
-7 % 3 = 2 in Python (vs -1 in C). Also: divmod(a,b).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<floor division\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{Floor[(3 + 4) / 2], Floor[(-3 - 4) / 2]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[(3 + 4) // 2, (-3 - 4) // 2]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<// operator rounds toward negative infinity.\n-7//2 = -4 \
in Python (vs -3 in C truncation).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<max\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{Max[2,3], Max[{2,7,3}]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[max(2,3), max([2,7,3])]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<max(iterable) or max(a,b,...). O(n).\nSupports key= \
parameter. min() for minimum.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<math\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<accumulate\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Accumulate[{1,2,3,4,5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l=[1,2,3,4,5];running = 0\\n[running := running+i for i in \
l]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<itertools.accumulate(iterable, func=operator.add).\n\
Returns running totals (prefix sums) by default.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "math", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233811059684*^9, 3.9702338179336967`*^9}, {
   3.971116482603587*^9, 3.9711165033934383`*^9}, {3.971116708900804*^9, 
   3.9711167595119867`*^9}, 3.98510775673186*^9},
 CellLabel->
  "In[488]:=",ExpressionUUID->"29555c9a-b107-4f46-9f46-2b09bede8e35"]
}, Closed]],

Cell[CellGroupData[{

Cell["logic", "Subsubsection",
 CellChangeTimes->{
  3.970233362394113*^9},ExpressionUUID->"77f320bf-d345-47b5-aa93-\
9146b53b1779"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"logic", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "logic", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<logic\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<logical AND / OR / NOT\>\""}], ",", 
       
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<a=3; b=5; {a < b && b > 4, a > b || b == 5, ! (a == \
b)}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<a = 3; b = 5; [a < b and b > 4, a > b or b == 5, not (a == \
b)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<&& = And, || = Or, ! = Not in Wolfram; and/or/not in \
Python\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<logic\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<short-circuit behaviour\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<a = False; b = Print[\\\"hi\\\"]; a && b\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<a = False\\n def f():\\n     print(\\\"hi\\\"); return \
True\\nprint(a and f())\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<right\[Hyphen]side only evaluated if needed \
(short-circuit)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<logic\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<chaining comparisons & logic\>\""}],
        ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<x = 10; {0 < x < 15 && ! (x < 5 || x > 20)}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<x = 10; [0 < x < 15 and (not (x < 5 or x > 20))]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<combines comparisons and logical operators\>\""}]}], 
      "|>"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "logic", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233841451522*^9, 3.970233853850645*^9}, 
   3.970234137841345*^9, {3.985107811693136*^9, 3.985107811895914*^9}},
 CellLabel->
  "In[490]:=",ExpressionUUID->"32f92a6f-93f9-46e3-a832-0d550a03f566"]
}, Closed]],

Cell[CellGroupData[{

Cell["regex", "Subsubsection",
 CellChangeTimes->{{3.970240780556356*^9, 
  3.970240781596426*^9}},ExpressionUUID->"346a325a-ac8a-4129-8c64-\
30eeba297640"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"regex", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<regex\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<basic split\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s=\\\"20s10\\\";StringSplit[s,RegularExpression[\\\"(\\\\d+\
)\\\"]->\\\"$1\\\",All]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s = \\\"20s10\\\";re.split(r'(\\\\d+)', s)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<letters followed by digits\>\""}]}],
       "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<regex\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<basic match\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringMatchQ[\\\"hello123\\\", \
RegularExpression[\\\"^[a-z]+\\\\d+\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<bool(re.match(r\\\"^[a-z]+\\\\d+\\\", \\\"hello123\\\"))\>\
\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<letters followed by digits\>\""}]}],
       "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<regex\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<findall match\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<s=\\\"Order #1234: 3 items \[LongDash] IDs A45, B78, C102; \
date 2025-11-10;\\ntotal $256.75\\\";\n\
g=StringCases[s,RegularExpression[#1]->#2]&;\n\
{g[\\\"(\\\\d+)\\\",\\\"$1\\\"],g[\\\"\\$([0-9]+\\\\.[0-9]{2})\\\",\\\"$1\\\"]\
,\ng[\\\"(20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\\\",\\\"$1\\\"]\
,\ng[\\\"([A-Z][0-9]+)\\\",\\\"$1\\\"],g[\\\"Order #([0-9]+)\\\",\\\"$1\\\"]}\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<s=\\\"Order #1234: 3 items \[LongDash] IDs A45, B78, C102; \
date 2025-11-10;\\\"\\ns+=\\\"total $256.75\\\"\ng = lambda p: \
re.findall(rf\\\"{p}\\\", s)\n\
[g(\\\"(\\\\d+)\\\"),g(\\\"\\$([0-9]+\\\\.[0-9]{2})\\\"),\n\
[g(\\\"(20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\\\")[0][0]],\ng(\
\\\"([A-Z][0-9]+)\\\"),g(\\\"Order #([0-9]+)\\\")]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<(1) captures any continuous digits;\\n(2) finds dollar \
amounts with two decimal places;\\n(3) matches a date in the format \
YYYY-MM-DD;\\n(4) captures an uppercase letter followed by digits \
(IDs);\\n(5) Order #([0-9]+) catches the number after \
\[OpenCurlyDoubleQuote]Order #\[CloseCurlyDoubleQuote].\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<regex\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<replace whitespace\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringReplace[\\\"The rain in Spain\\\", \
RegularExpression[\\\"\\\\s+\\\"] -> \\\"_\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<re.sub(r\\\"\\\\s+\\\", \\\"_\\\", \\\"The rain in Spain\\\
\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<replace whitespace by underscore\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<regex\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<email validation\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringMatchQ[\\\"alice-b@google.com\\\",\\n \
RegularExpression[\\\"^[\\\\w\\\\.\\\\-]+@[\\\\w\\\\.\\\\-]+\\\\.[a-zA-Z]{2,4}\
$\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<bool(re.match(r\\\"^[\\\\w\\\\.\\\\-]+@[\\\\w\\\\.\\\\-]+\\\
\\.[a-zA-Z]{2,4}$\\\",\\n \\\"alice-b@google.com\\\"))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<simple email format check\>\""}]}], 
      "|>"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Quiet", "[", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Values", "[", "regex", "]"}], ",", 
    RowBox[{"Frame", "->", "All"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.97024078516364*^9, 3.970240788155156*^9}, {
   3.970324647142901*^9, 3.970324649462698*^9}, {3.9703273383122683`*^9, 
   3.970327341607782*^9}, {3.970327485076043*^9, 3.970327487484185*^9}, {
   3.9703275630388947`*^9, 3.97032757220584*^9}, 3.970327758708499*^9, {
   3.9710904630962543`*^9, 3.9710904781383133`*^9}, {3.9710915862725983`*^9, 
   3.971091631542984*^9}, {3.971091683412603*^9, 3.971091684042244*^9}, {
   3.971092147964698*^9, 3.971092167957795*^9}, {3.971113741851903*^9, 
   3.971113752816455*^9}, {3.97179863395024*^9, 3.971798785136983*^9}, {
   3.971799071007874*^9, 3.971799108313222*^9}, {3.971799444597822*^9, 
   3.971799487392776*^9}, 3.971799547857513*^9, {3.97179966933634*^9, 
   3.97179972952085*^9}, {3.971799847525606*^9, 3.971799848408525*^9}, {
   3.971800950869741*^9, 3.971800972907214*^9}, {3.9718011388829603`*^9, 
