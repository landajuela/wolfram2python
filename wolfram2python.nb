Cell[CellGroupData[{

Cell["equivalence", "Subsubsection",
 CellChangeTimes->{
  3.970233214677718*^9},ExpressionUUID->"d0aa8581-3341-4358-8346-\
2d7df2433dc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"equivalence", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "equivalences", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<equivalence\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<map & comprehension\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Map[#^2&,{1,2,3,4}]==Table[x^2,{x,{1,2,3,4}}]\>\""}], ",", 
       
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<list(map(lambda x: x**2, [1,2,3,4])) == [x**2 for x in \
[1,2,3,4]]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<map() returns a map object (you need list())\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<equivalence\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<filter & comprehension\>\""}], ",", 
       
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Select[{1, 2, 3, 4}, \
(Mod[#,2]==0)&]==Table[\\nIf[Mod[x,2]==0,x,Nothing],{x,{1,2,3,4}}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<list(filter(lambda x: x % 2 == 0, [1,2,3,4])) == [x \\n \
for x in [1,2,3,4] if x % 2 == 0]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<filter() returns a filter object (you need \
list())\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "equivalence", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233645048252*^9, 3.9702336640044117`*^9}, {
  3.971090506370833*^9, 3.971090522868442*^9}, {3.971090933388702*^9, 
  3.971090947502989*^9}},
 CellLabel->
  "In[478]:=",ExpressionUUID->"5a2e0501-923c-41fb-b75b-e4ae20e694b2"]
}, Closed]],

Cell[CellGroupData[{

Cell["functional programming", "Subsubsection",
 CellChangeTimes->{
  3.970233214677718*^9, {3.970233340088019*^9, 
   3.970233342274826*^9}},ExpressionUUID->"3925c136-6476-4178-80c2-\
492ecd39cf7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"functionalProgramming", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"functional", " ", "programming"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<anonymous function\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<#^2&[2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<(lambda x: x**2)(2)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<lambda is limited to a single expression in Python.\nFor \
multi-line logic, use def instead.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<anonymous function (2D)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<(#1 + #2)&[1,2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<(lambda x,y: x + y)(1, 2)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python lambda supports multiple args: lambda x,y: x+y.\n\
Can also use *args/**kwargs.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<map\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Map[2+#&,{2,2,9,6,7}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<map(lambda x : 2 + x, [2, 2, 9, 6, 7])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<map is better done with comprehension in Python\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<map comprehension\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Table[2 + x, {x, {2, 2, 9, 6, 7}}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[2 + x for x in [2, 2, 9, 6, 7]]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<Pythonic\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<select/filter\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Select[{1, 2, 3, 4}, (Mod[#,2]==0)&]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<filter(lambda x: x % 2 == 0, [1,2,3,4])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<filter is better done with comprehension in \
Python\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<select/filter comprehension\>\""}], 
       ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Table[If[Mod[x,2]==0,x,Nothing],{x,{1,2,3,4}}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[x for x in [1,2,3,4] if x % 2 == 0]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<Pythonic\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "reduce", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<fold (reduce)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Fold[Plus, 0, {1,2,3,4}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from functools import reduce\\nreduce(lambda a,b: a+b, \
[1,2,3,4])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<reduce applies a binary function cumulatively to the items \
of\\nan iterable, from left to right, to produce a single value.\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<fold (no reduce)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Fold[Plus, 0, {1,2,3,4}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<lst=[1,2,3,4];running = 0\\n[running := running + x for x \
in lst]; running\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<The walrus operator (:=) in Python allows you to \
assign\\na value to a variable within an expression and also return that \
value.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<nest (reduce)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Nest[#/2&, 16., Log[2,16]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from functools import reduce; import math\\nreduce(lambda \
acc, _: acc / 2, range(int(math.log(16, 2))), 16)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Repeated function application using functools.reduce.\n\
reduce(f, iterable) applies f cumulatively left-to-right.\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<nest (no reduce)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Nest[#/2&, 16., Log[2,16]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import math; x = 16\\n[x := x/2 for _ in \
range(int(math.log(x, 2)))][-1]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Loop-based equivalent of functional nesting.\nExplicit \
loop is often more readable in Python.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<functional\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<func nest\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<NestList[#^2&,2,4]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<f, x, n = lambda v: v**2, 2, 4;running = x\\n[running] + \
[running := f(running) for _ in range(n)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Compose functions: reduce(lambda v,f: f(v), [f1,f2,f3], \
x).\nOr use functools.reduce with reversed function list.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "functionalProgramming", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233691690172*^9, 3.970233706631365*^9}, {
   3.97032189043209*^9, 3.9703218963530197`*^9}, {3.970778695982872*^9, 
   3.970778696988001*^9}, {3.971112722576804*^9, 3.971112725184729*^9}, {
   3.971112775706686*^9, 3.9711128031407757`*^9}, {3.971112977480221*^9, 
   3.971112988688361*^9}, {3.97111322369639*^9, 3.97111323159361*^9}, 
   3.97111329652691*^9, {3.971114362226907*^9, 3.971114379055313*^9}, {
   3.97111466803294*^9, 3.9711147378904448`*^9}, {3.971114941178051*^9, 
   3.971114965059985*^9}, {3.971115063006093*^9, 3.9711150692524853`*^9}, {
   3.971115325897687*^9, 3.971115344483824*^9}, 3.985089737021431*^9},
 CellLabel->
  "In[480]:=",ExpressionUUID->"2bc42435-c989-4aa4-98b2-8eec1b2eafd7"]
}, Closed]],

Cell[CellGroupData[{

Cell["procedural programming", "Subsubsection",
 CellChangeTimes->{
  3.970233214677718*^9, {3.970233346377681*^9, 
   3.970233348795795*^9}},ExpressionUUID->"18560e7c-ecaa-43ec-a406-\
800223f0c9b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"proceduralProgramming", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"procedural", " ", "programming"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<procedural\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<if\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<If[3>2,Print[\\\"true\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<if 3 > 2:\\n    print(\\\"true\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python uses if/elif/else (indentation-based, no braces).\n\
No switch/case before Python 3.10 (use match/case).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<procedural\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<if assign\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<If[3 < 2, 3, 2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<3 if 3 < 2 else 2\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Ternary expression: x = a if condition else b.\nSingle \
line, evaluates lazily.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<procedural\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<for loop\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Do[Print[i], {i, 1, 5}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<for i in range(1,6):\\n    print(i)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<for item in iterable: body.\nUse enumerate(seq) for \
index+value; range(n) for counting.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<procedural\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<while loop\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<i = 0;\\nWhile[i < 5, i++; Print[i]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<i = 0\\nwhile i < 5: i += 1; print(i)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<while condition: body.\nbreak/continue to control flow. \
Supports else clause.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<procedural\\nprogramming\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<break/exit loop\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<For[i = 1, i < 10, i++,\\n If[i > 5, Break[]]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<for i in range(1,10):\\n    if i > 5: break\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<break exits innermost loop; continue skips to next \
iteration.\nPython for/while has else clause: runs if loop completes without \
break.\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "proceduralProgramming", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233717778599*^9, 3.970233737847968*^9}, {
   3.971112877295595*^9, 3.971112877416272*^9}, {3.971265086459004*^9, 
   3.971265155231453*^9}, 3.985089893238099*^9},
 CellLabel->
  "In[482]:=",ExpressionUUID->"1110ce14-fb31-4141-b54d-586278309a3d"]
}, Closed]],

Cell[CellGroupData[{

Cell["dataframe", "Subsubsection",
 CellChangeTimes->{3.970233214677718*^9, 
  3.970233351816613*^9},ExpressionUUID->"0102511f-6766-4d01-ac77-\
13ebba53e971"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataframe", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "dataframe", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<dataset/dataframe\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"\
b\\\"->4|>}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2}, {\\\"a\\\": 3, \
\\\"b\\\": 4}])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Every pandas DataFrame always has an index, it can not \
completely removed.\\npd.DataFrame({\\\"a\\\":[1, 3],\\\"b\\\":[2, \
4]})\\npd.DataFrame([[1, 2],[3, 4]], columns=[\\\"a\\\", \\\"b\\\"])\>\""}]}],
       "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<shape\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df=Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\
\"b\\\"->4|>}];\\nDimensions[df]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\": 1,\\\"b\\\": 2},{\\\"a\\\": \
3,\\\"b\\\": 4}])\\ndf.shape\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df.shape returns (nrows, ncols) tuple.\ndf.columns for \
column names; df.dtypes for types.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract value from df\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\n{df[\
[1,\\\"b\\\"]],df[[1,\\\"b\\\"]],df[[1,2]],df[[1,2]],\\nNormal[Values[df[[1]]]\
],Normal[Values[df[[1]]]]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\":1, \\\"b\\\":2}, {\\\"a\\\":3, \
\\\"b\\\":4}])\\n[df.loc[0,\\\"b\\\"], df.at[0,\\\"b\\\"],df.iloc[0,1], \
df.iat[0,1],\\ndf.loc[0].values.tolist(), df.iloc[0].values.tolist()]\>\""}], 
       ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<loc / at = Labels; iloc / iat = Index positions;\\nat & \
iat = Accelerated scalar access (fastest)\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract column from df\>\""}], ",", 
       
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
All, \\\"a\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2}, \
{\\\"a\\\": 3, \\\"b\\\": 4}])\\nlist(df[\\\"a\\\"].values)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df['col'] returns Series; df[['col']] returns 1-col \
DataFrame.\nBracket type matters for downstream operations.\>\""}]}], "|>"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract multiple columns\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2,\\\"c\\\"->4|>,\\n<|\\\"a\\\"->3,\\\"b\\\
\"->4,\\\"c\\\"->5|>}]; df[All, {\\\"a\\\", \\\"b\\\"}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2, \\\"c\\\": \
3},\\n{\\\"a\\\": 3, \\\"b\\\": 4, \\\"c\\\": 5}]); df[[\\\"a\\\", \
\\\"b\\\"]]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df[['a','b']] or df.loc[:, ['a','b']].\nReturns a new \
DataFrame (copy by default).\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract row\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
1]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2}, \
{\\\"a\\\": 3, \\\"b\\\": 4}])\\ndf.iloc[0]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df.iloc[0] by integer position; df.loc['label'] by index \
label.\nReturns a Series with column names as index.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<remove/drop columns\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2,\\\"c\\\"->4|>,<|\\\"a\\\"->3,\\\"b\\\"->\
4,\\\"c\\\"->5|>}];\\ndf[All, KeyDrop[\\\"c\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\":1,\\\"b\\\":2,\\\"c\\\":4},{\\\
\"a\\\":3,\\\"b\\\":4,\\\"c\\\":5}])\\ndf.drop(columns=[\\\"c\\\"])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<In Mathematica, a Dataset can\[CloseCurlyQuote]t truly be \
modified in place,\\nevery change effectively creates a new Dataset object.\>\
\""}]}], "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<select/filter rows\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
Select[#[\\\"a\\\"]>1&&#[\\\"b\\\"]>1&]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\":1,\\\"b\\\":2},{\\\"a\\\":3,\\\
\"b\\\":4},{\\\"a\\\":2,\\\"b\\\":-1}])\\ndf[(df[\\\"a\\\"]>1) & \
(df[\\\"b\\\"]>1)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Boolean indexing: df[df['col'] > val].\nCombine conditions \
with & (and), | (or), ~ (not). Use parentheses.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<transform column\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2,\\\"c\\\"->4|>,<|\\\"a\\\"->3,\\\"b\\\"->\
4,\\\"c\\\"->5|>}];\\ndf[All, \
Association[#,\\\"b\\\"->(#[\\\"b\\\"]^2)]&]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\":1,\\\"b\\\":2,\\\"c\\\":4},{\\\
\"a\\\":3,\\\"b\\\":4,\\\"c\\\":5}])\\ndf[\\\"b\\\"]=df[\\\"b\\\"].apply(\
lambda x:x**2);df\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df['col'] = df['col'].apply(func) for element-wise \
transform.\nPrefer vectorized ops for speed.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<append vectorized column\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
All, Append[#, \\\"c\\\" -> #a + #b] &]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2}, \
{\\\"a\\\": 3, \\\"b\\\": 4}])\\ndf[\\\"c\\\"] = df[\\\"a\\\"] + \
df[\\\"b\\\"]; df\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Vectorized: df['new'] = df['a'] + df['b'].\nMuch faster \
than apply() or iterating rows.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<append new column\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
All, Append[#, \\\"a_sq\\\" -> (#a)^2] &]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 2}, \
{\\\"a\\\": 3, \\\"b\\\": 4}])\\ndf[\\\"a_sq\\\"] = \
df[\\\"a\\\"].apply(lambda x: x**2);df\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df['new'] = expression adds column in-place.\nAlternative: \
df.assign(new=expr) returns new DataFrame.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<method chaining\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df = \
Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->2|>,<|\\\"a\\\"->3,\\\"b\\\"->4|>}];\\ndf[\
Select[#a>1&]][All,Append[#,\\\"d\\\"->#a*#b]&][All,{\\\"b\\\",\\\"d\\\"}]\>\"\
"}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df = pd.DataFrame([{\\\"a\\\":1,\\\"b\\\":2},{\\\"a\\\":3,\
\\\"b\\\":4}])\\n(df[df[\\\"a\\\"]>1].assign(d=lambda \
x:x[\\\"a\\\"]*x[\\\"b\\\"]).loc[:,[\\\"b\\\",\\\"d\\\"]])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df.method1().method2() chains operations.\nUse .pipe(func) \
for custom functions; .assign() for new columns.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<group by\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<patients=Dataset[{<|\\\"city\\\"->\\\"A\\\",\\\"age\\\"->\
30.|>,\\n<|\\\"city\\\"->\\\"B\\\",\\\"age\\\"->45.|>,<|\\\"city\\\"->\\\"A\\\
\",\\\"age\\\"->50.|>}];\\nNormal[patients[GroupBy[\\\"city\\\"],Mean,\\\"age\
\\\"]]\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<patients=pd.DataFrame([{'city': 'A', 'age': 30},\\n \
{'city': 'B', 'age': 45}, {'city': 'A', 'age': \
50}])\\npatients.groupby('city')['age'].mean().to_dict()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df.groupby('col').agg(func). Returns grouped DataFrame.\n\
.transform() preserves original shape; .apply() for custom logic.\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<dataframe\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort by\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<df=Dataset[{<|\\\"a\\\"->1,\\\"b\\\"->4|>,<|\\\"a\\\"->3,\\\
\"b\\\"->3|>,\\n <|\\\"a\\\"->3,\\\"b\\\"->2|>}]; df[SortBy[#[\\\"b\\\"]&]]\>\
\""}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<df=pd.DataFrame([{\\\"a\\\": 1, \\\"b\\\": 4}, {\\\"a\\\": \
3, \\\"b\\\": 3},\\n {\\\"a\\\": 3, \\\"b\\\": 2}]); \
df.sort_values(by=\\\"b\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<df.sort_values('col', ascending=False). Stable sort \
(Timsort).\ndf.sort_index() to sort by index.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\n", 
