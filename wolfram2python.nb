Cell[BoxData[{
 RowBox[{
  RowBox[{"general", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "general", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<range\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{Range[0,7],Range[0,7,2]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[range(0,7+1),range(0,7+1,2)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Mathematica\[CloseCurlyQuote]s Range = inclusive \
range.\\nPython\[CloseCurlyQuote]s range = half-open range (includes start, \
excludes stop)\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<func\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<f[x_,y_Integer:2]:=x+2+y;f[2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<def f(x,y:int=2): return 2+x+y\\nf(2)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<In Python, if a function does not explicitly return a \
value,\\nit implicitly returns None.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<objects\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<l={1,2,3};\\nf=(AppendTo[l,#])&;\\nf[4];l\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<l = [1,2,3]\\nf = lambda x: l.append(x)\\nf(4);l\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Lists are modified in place because functions\\nreceive a \
reference to the same list object rather than a copy.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
         RowBox[{"\"\<name\>\"", "->", "\"\<variableAssignmentScope\>\""}], ",", 
         RowBox[{"\"\<wolfram_code\>\"", 
          "->", "\"\<y=3;f[x_]:={y=4};\\nf[3];y\>\""}], ",", 
         RowBox[{"\"\<python_code\>\"", 
          "->", "\"\<y = 3\\ndef f(x): y = 4\\nf(3);y\>\""}], ",", 
         RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
         RowBox[{"\"\<note\>\"", 
          "->", "\"\<In Mathematica y stay global, in Python there is a local \
copy\>\""}]}], "|>"}], ","}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<global\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Names[\\\"Global`*\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<globals()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<globals() returns dict of current global symbol \
table.\\nUseful for debugging and introspection.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<print\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Print[\\\"Hello world\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<print(\\\"Hello world\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<print() outputs to stdout with default newline.\\nSupports \
sep=, end=, file= keyword args.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<print val\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Print[\\\"val=\\\"<>ToString[5]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<print(f\\\"val={str(5)}\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<f-strings in Python\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<counter\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Counts[{1,1,2,2,2,4}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<from collections import \
Counter\\ndict(Counter([1,1,2,2,2,4]))\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Counter is a dict subclass for counting hashable \
objects.\\nO(n) to construct. .most_common(k) returns top k.\>\""}]}], "|>"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<add to\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<i=2;i+=1;i\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<i=2;i+=1;i\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Python has +=, -=, *=, //=, **= augmented assignment.\\nNo \
++ or -- operators in Python.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<help\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<?Sort\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<help(sorted)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<help(obj) invokes built-in help. dir(obj) lists \
attributes.\\ntype(obj) returns the type.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<null\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<None\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<None\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<None is Python's null singleton.\\nAlways check with 'is \
None', not '== None'.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<walrus\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{{x=16},x}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<[[x:=16],x]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<The := walrus operator lets you assign a value to \
a\\nvariable inside an expression and returns that value.\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<arg unpacking\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<f[a_,b_,c_]:={a,b,c}\\nargs={1,2};kwargs=<|\\\"c\\\"->3|>;\
\\nf[Sequence@@args,kwargs[\\\"c\\\"]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<def f(a, b, c): return [a, b, c]\\nargs = [1, 2]; kwargs = \
{\\\"c\\\": 3}\\nf(*args,**kwargs)# f(1, 2, c=3)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<* unpacks iterables into positional args;\\n** unpacks \
dicts into keyword args.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", " ", 
       RowBox[{"\"\<name\>\"", "->", "\"\<err. handling\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<x=4;y=0;\\nQuiet@Check[x/y,(\\\"Err:Zero-div\\\";$Failed)];\
\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<x=4;y=0;\\ntry: x / y\\nexcept \
ZeroDivisionError:\\n\\tprint(\\\"Err:Zero-div\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<try/except/else/finally. Use specific exception \
types.\\nexcept runs on error; else runs if no error; finally always \
runs.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<dir\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Names[\\\"Global`*\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<dir()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<dir() without arguments lists names in the current local \
scope.\\nIn Wolfram, Names[\\\"Global`*\\\"] lists symbols in the Global \
context.\>\""}]}], "|>"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<dir obj\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<Attributes[List]\\nOptions[List]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<dir(list)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<dir(obj) lists an object's attributes/methods.\\nWolfram \
has no exact equivalent; try Attributes, Options, DownValues, or \
?symbol.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<type\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<Head[expr]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<type(obj)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<type(obj) returns an object's type/class.\\nIn Wolfram, \
Head[expr] returns the expression's head.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<general\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<isinstance\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{MatchQ[5, _Integer],\\nMatchQ[\\\"hi\\\", \
_String]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[isinstance(5, int),\\nisinstance(\\\"hi\\\", str)]\>\""}],
        ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<isinstance(obj, cls) checks whether an object has a given \
type.\\nIn Wolfram, use predicate functions like IntegerQ/StringQ or \
MatchQ.\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
