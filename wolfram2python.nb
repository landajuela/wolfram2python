Cell[BoxData[{
 RowBox[{
  RowBox[{"string", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", "string", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string format\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<ToString[StringForm[\\\"The values are x=`` and y=``.\\\", \
5, 10]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<\\\"The values are x={} and y={}.\\\".format(5, 10)\>\""}],
        ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<f-strings f'{expr}' are fastest (Python 3.6+).\nAlso: \
'{}'.format(val) and '%s' % val (legacy).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string join\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringRiffle[{2, 2, 9, 6, 7}, \\\" \\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<' '.join([\\\"2\\\", \\\"2\\\", \\\"9\\\", \\\"6\\\", \
\\\"7\\\"])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<'sep'.join(iterable). O(n) total characters.\nEfficient: \
builds result in one pass.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<substring\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringTake[\\\"abcdef\\\", {2,4}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<\\\"abcdef\\\"[1:4]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<s[start:end] slicing. Strings are immutable sequences.\n\
Negative indices count from end.\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string length\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringLength[\\\"hello\\\"]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", "->", "\"\<len(\\\"hello\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<O(1) - stored as attribute. len(s).\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string check\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{LetterQ[\\\"a\\\"],DigitQ[\\\"5\\\"]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[\\\"a\\\".isalpha(),\\\"5\\\".isdigit()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Membership: 'sub' in s is O(n*m).\nAlso: s.isdigit(), \
s.isalpha(), s.isalnum(), s.isspace().\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string case\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{ToUpperCase[\\\"hello\\\"],Capitalize[\\\"hello\\\"]}\>\""}\
], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[\\\"hello\\\".upper(),\\\"hello\\\".capitalize()]\>\""}], 
       ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<not in-place, strings are immutable in Python, return a \
new string\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string padding\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{StringPadLeft[\\\"42\\\",5,\\\"0\\\"],StringPadRight[\\\"\
left\\\",10,\\\"-\\\"],\\nStringPadLeft[\\\"right\\\",10,\\\"-\\\"]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[\\\"42\\\".zfill(5),\\\"left\\\".ljust(10, \
\\\"-\\\"),\\\"right\\\".rjust(10, \\\"-\\\")]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<not in-place\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string split\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{StringSplit[\\\"a,b,,c\\\", \
\\\",\\\"],StringSplit[\\\"line1\\\\nline2\\\", \\\"\\\\n\\\"]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[\\\"a,b,,c\\\".split(\\\",\\\"),\\\"line1\\\\nline2\\\".\
splitlines()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<not in-place\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<replace substring\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<StringReplace[\\\"a_b_c\\\", \\\"_\\\"->\\\"-\\\"]\>\""}], 
       ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<\\\"a_b_c\\\".replace(\\\"_\\\",\\\"-\\\")\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<s.replace(old, new) returns new string (immutable).\n\
s.replace(old, new, count) limits replacements.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<string starts\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<{StringStartsQ[\\\"beach\\\", \
\\\"_\\\"],StringStartsQ[\\\"beach\\\", \\\"b\\\"]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<[\\\"beach\\\".startswith('_'),\\\"beach\\\".startswith('b'\
)]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<s.startswith('pre'), s.endswith('suf').\nAccept tuples: \
s.startswith(('http','ftp')).\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<string\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<sort\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<sl={\\\"s2\\\",\\\"s10\\\",\\\"s50\\\",\\\"a\\\"};\\\
nSortBy[sl,StringCases[#,x:(DigitCharacter..|LetterCharacter..):>If[\\\
nStringMatchQ[x,DigitCharacter..],ToExpression[x],ToLowerCase[x]]]&]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<import \
re;sl=[\\\"s2\\\",\\\"s10\\\",\\\"s50\\\",\\\"a\\\"];\\nsorted(sl, key=lambda \
s : [int(t) if t.isdigit() else t.lower()\\n for t in re.split(r'(\\\\d+)', \
s)])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<sorted(s) returns list of chars.\n''.join(sorted(s)) for \
sorted string. Strings are immutable.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "string", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.970233782026887*^9, 3.970233787016786*^9}, {
