Cell[CellGroupData[{

Cell["numpy", "Subsubsection",
 CellChangeTimes->{{3.970240780556356*^9, 3.970240781596426*^9}, {
  3.970831328754921*^9, 
  3.970831329562405*^9}},ExpressionUUID->"955685f3-b154-447a-8daa-\
0ff05ffbd391"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numpy", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<numpy array\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", "->", "\"\<{{1,2},{3,4}}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<np.array([[1, 2], [3, 4]]).tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Create a simple 2\[Times]2 numeric array\>\""}]}], "|>"}], 
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract value (row1,col2)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2},{3,4}};\\nm[[1,2]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m=np.array([[1,2],[3,4]])\\nm[0,1]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Wolfram uses 1-based indexing; NumPy uses 0-based\>\""}]}],
       "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract row 1\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2},{3,4}};\\nm[[1]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m = np.array([[1,2],[3,4]])\\nm[0].tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<First row of the array\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<extract column 2\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2},{3,4}};\\nm[[All,2]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m = np.array([[1,2],[3,4]])\\nm[:,1].tolist()\>\""}], ",", 
       
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<All rows, second column\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", 
        "->", "\"\<select sub-array columns 1 and 2\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m={{1,2,3},{3,4,5}};\\nm[[All, {1,2}]]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m = \
np.array([[1,2,3],[3,4,5]])\\nm[:,[0,1]].tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Select first and second columns\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<transpose array\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2,3},{4,5,6}};\\nTranspose[m]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m=np.array([[1,2,3],[4,5,6]])\\n(m.T).tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<Transpose operation\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<matrix multiplication\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m1 = {{1,2},{3,4}};\\nm2 = {{5,6},{7,8}};\\n{Dot[m1,m2], \
m1 . m2}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m1 = np.array([[1,2],[3,4]])\\nm2 = \
np.array([[5,6],[7,8]])\\n[np.dot(m1, m2).tolist(), (m1 @ \
m2).tolist()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Use @ operator (or np.dot) for matrix \
multiplication\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<filter rows\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2},{3,4},{2,-1}};\\nSelect[m, #[[1]]>1 &]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m = np.array([[1,2],[3,4],[2,-1]])\\nm[m[:,0] > \
1].tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", "->", "\"\<Boolean masking in NumPy\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<transform column (numpy)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2,4},{3,4,5}};\\nm[[All,2]] = m[[All,2]]^2; \
m\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m=np.array([[1,2,4],[3,4,5]])\\nm[:,1]=(m[:,1]**2); \
m.tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Modify second column by squaring values\>\""}]}], "|>"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<append new column (numpy)\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m = {{1,2},{3,4}};\\nJoin[m, \
Transpose[{m[[All,1]]+m[[All,2]]}],2]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m=np.array([[1,2],[3,4]])\\nm=np.column_stack((m, \
m[:,0]+m[:,1]))\\nm.tolist()\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<Add a new column equal to a+b\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<multinormal\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<RandomVariate[MultinormalDistribution[\\n{-2,0},{{1,0.9},{\
0.9,1}}],10]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<np.random.multivariate_normal(\\nmean=[-2,0],cov=[[1,0.9],[\
0.9,1]],size=10)\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<np.random.multivariate_normal(mean, cov, size).\nReturns \
samples from multivariate normal distribution.\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<permutation\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<RandomSample[{1,2,3}]\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<np.random.permutation([1,2,3])\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "False"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<np.random.permutation(n) returns shuffled arange(n).\nAlso \
shuffles arrays. For in-place: np.random.shuffle().\>\""}]}], "|>"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<stack\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m1={{1,2},{3,4}};\\nm2={{5,6},{7,8}};\\n{Join[m1,m2],\
ArrayFlatten[{{m1,m2}}]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m1=np.array([[1,2],[3,4]])\\nm2=np.array([[5,6],[7,8]])\\n[\
np.vstack([m1,m2]).tolist(),\\nnp.hstack([m1,m2]).tolist()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<np.vstack (row-wise), np.hstack (col-wise), \
np.column_stack.\nnp.concatenate(arrays, axis=) for general case.\>\""}]}], 
      "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<cat\>\"", "->", "\"\<numpy\>\""}], ",", 
       RowBox[{"\"\<name\>\"", "->", "\"\<reshape\>\""}], ",", 
       RowBox[{"\"\<wolfram_code\>\"", 
        "->", "\"\<m={{1,2},{3,4}};\\n{ArrayReshape[m,{1,4}],ArrayReshape[m,{\
4,1}]}\>\""}], ",", 
       RowBox[{"\"\<python_code\>\"", 
        "->", "\"\<m=np.array([[1,2],[3,4]])\\n[m.reshape(1,4).tolist(),m.\
reshape(4,1).tolist()]\>\""}], ",", 
       RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<note\>\"", 
        "->", "\"\<arr.reshape(shape). Use -1 to infer one dimension.\nMust \
preserve total element count. Returns view when possible.\>\""}]}], "|>"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Values", "[", "numpy", "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
